# Phase 7 — Recommendation API
# Copy to .env and fill in values. Never commit .env.

# Default: mock LLM (free, no API calls). Set to false for real Claude.
USE_MOCK_LLM=true

# Required only when USE_MOCK_LLM=false (console.anthropic.com — separate from Claude Pro)
ANTHROPIC_API_KEY=

# Cheap model for dev when using real API (optional override)
CLAUDE_MODEL=claude-3-haiku-20240307

# ChromaDB path (must match processor.py)
CHROMA_PATH=src/chroma_vault
