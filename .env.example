# Recommendation API — copy to .env and adjust as needed.

# Use mock responses (no API key). Set false to call Claude via the Anthropic API.
USE_MOCK_LLM=true

# Required when USE_MOCK_LLM=false
ANTHROPIC_API_KEY=

# Model for live API calls (optional)
CLAUDE_MODEL=claude-3-haiku-20240307

# ChromaDB path — must match processor.py
CHROMA_PATH=src/chroma_vault
